# --- Local Postgres ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=alessaips
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_SSL=false

# --- Supabase (Session Pooler, recomendado para backends con pool de conexiones) ---
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your_supabase_db_password
# DB_SSL se omite (usa SSL por defecto, requerido por Supabase)

PORT=3000

# --- Supabase Storage (bucket 'ips-documents': plantillas subidas por usuario) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
